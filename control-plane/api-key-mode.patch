diff --git a/hindsight-control-plane/src/lib/auth/api-key-login.ts b/hindsight-control-plane/src/lib/auth/api-key-login.ts
new file mode 100644
index 000000000..ea503f266
--- /dev/null
+++ b/hindsight-control-plane/src/lib/auth/api-key-login.ts
@@ -0,0 +1,58 @@
+import { NextRequest, NextResponse } from "next/server";
+
+import {
+  API_KEY_SESSION_MAX_AGE_SECONDS,
+  OWN_AUTH_HEADER,
+  sealApiKey,
+} from "@/lib/auth/api-key-session";
+import { ACCESS_KEY_COOKIE, sessionCookieOptions } from "@/lib/auth/session";
+import { DATAPLANE_URL, USER_AGENT } from "@/lib/hindsight-client";
+import { localizeApiErrorPayload } from "@/lib/i18n/api-errors";
+
+/**
+ * API-key mode sign-in: the key is good if the dataplane accepts it for listing
+ * banks (what the UI does first). The session cookie then carries it, sealed.
+ */
+export async function apiKeyLogin(
+  request: NextRequest,
+  apiKey: string | undefined,
+  secret: string
+): Promise<NextResponse> {
+  let status = 401;
+  if (apiKey && typeof apiKey === "string") {
+    try {
+      const response = await fetch(`${DATAPLANE_URL}/v1/default/banks?limit=1`, {
+        headers: {
+          Authorization: `Bearer ${apiKey}`,
+          "User-Agent": USER_AGENT,
+          [OWN_AUTH_HEADER]: "1",
+        },
+        cache: "no-store",
+      });
+      status = response.status;
+    } catch {
+      status = 0;
+    }
+  }
+  if (status === 401 || status === 403) {
+    return NextResponse.json(
+      localizeApiErrorPayload(request, {
+        error: "Invalid access key",
+        errorKey: "api.errors.auth.invalidAccessKey",
+      }),
+      { status: 401 }
+    );
+  }
+  if (status !== 200 || !apiKey) {
+    return NextResponse.json({ error: "Failed to connect to server" }, { status: 502 });
+  }
+
+  const response = NextResponse.json({ success: true });
+  response.cookies.set({
+    name: ACCESS_KEY_COOKIE,
+    value: await sealApiKey(apiKey, secret),
+    ...sessionCookieOptions(request),
+    maxAge: API_KEY_SESSION_MAX_AGE_SECONDS,
+  });
+  return response;
+}
diff --git a/hindsight-control-plane/src/lib/auth/api-key-session.ts b/hindsight-control-plane/src/lib/auth/api-key-session.ts
new file mode 100644
index 000000000..0489394b9
--- /dev/null
+++ b/hindsight-control-plane/src/lib/auth/api-key-session.ts
@@ -0,0 +1,80 @@
+/**
+ * Per-user sign-in (HINDSIGHT_CP_AUTH_MODE=api-key).
+ *
+ * Each person signs in with their own dataplane API key instead of the shared
+ * access key, and every dataplane call made for them carries that key
+ * (see dataplane-fetch.ts). The dataplane decides what the key may see, so the
+ * control plane must point at a dataplane that authenticates keys (Hindsight
+ * with a tenant extension, or a gateway such as hindsight-gateway), never at an
+ * unauthenticated one.
+ *
+ * The session cookie holds the key sealed with AES-GCM under a key derived from
+ * HINDSIGHT_CP_ACCESS_KEY: the browser never sees the key again after sign-in,
+ * the cookie can't be forged or altered, and rotating HINDSIGHT_CP_ACCESS_KEY
+ * ends every session. Revoking a key at the dataplane takes effect at once.
+ */
+
+export const API_KEY_SESSION_MAX_AGE_SECONDS = 60 * 60 * 24 * 30;
+
+/** On a dataplane request that carries its own Authorization (the sign-in check). */
+export const OWN_AUTH_HEADER = "x-hindsight-cp-own-auth";
+
+const CLOCK_SKEW_TOLERANCE_SECONDS = 60;
+const AAD = new TextEncoder().encode("hindsight-cp-api-key-session");
+
+export function isApiKeyMode(): boolean {
+  return process.env.HINDSIGHT_CP_AUTH_MODE === "api-key";
+}
+
+export async function sealApiKey(apiKey: string, secret: string): Promise<string> {
+  const iv = crypto.getRandomValues(new Uint8Array(12));
+  const payload = JSON.stringify({ k: apiKey, iat: Math.floor(Date.now() / 1000) });
+  const sealed = await crypto.subtle.encrypt(
+    { name: "AES-GCM", iv, additionalData: AAD },
+    await sessionKey(secret),
+    new TextEncoder().encode(payload)
+  );
+  return `${toBase64Url(iv)}.${toBase64Url(new Uint8Array(sealed))}`;
+}
+
+/** The API key in a session cookie, or null if it's missing, altered or expired. */
+export async function openApiKey(token: string | undefined, secret: string): Promise<string | null> {
+  if (!token || !secret) return null;
+  const [ivPart, sealedPart, extra] = token.split(".");
+  if (!ivPart || !sealedPart || extra !== undefined) return null;
+  try {
+    const plain = await crypto.subtle.decrypt(
+      { name: "AES-GCM", iv: fromBase64Url(ivPart), additionalData: AAD },
+      await sessionKey(secret),
+      fromBase64Url(sealedPart)
+    );
+    const { k, iat } = JSON.parse(new TextDecoder().decode(plain));
+    const now = Math.floor(Date.now() / 1000);
+    if (typeof k !== "string" || !k || !Number.isInteger(iat)) return null;
+    if (iat > now + CLOCK_SKEW_TOLERANCE_SECONDS || now - iat > API_KEY_SESSION_MAX_AGE_SECONDS) return null;
+    return k;
+  } catch {
+    return null;
+  }
+}
+
+async function sessionKey(secret: string): Promise<CryptoKey> {
+  const digest = await crypto.subtle.digest(
+    "SHA-256",
+    new TextEncoder().encode(`hindsight-cp-api-key-session:${secret}`)
+  );
+  return crypto.subtle.importKey("raw", digest, "AES-GCM", false, ["encrypt", "decrypt"]);
+}
+
+function toBase64Url(bytes: Uint8Array): string {
+  let binary = "";
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replace(/=+$/, "").replace(/\+/g, "-").replace(/\//g, "_");
+}
+
+function fromBase64Url(text: string): Uint8Array<ArrayBuffer> {
+  const binary = atob(text.replace(/-/g, "+").replace(/_/g, "/"));
+  const out = new Uint8Array(binary.length);
+  for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i);
+  return out;
+}
diff --git a/hindsight-control-plane/src/lib/auth/dataplane-fetch.ts b/hindsight-control-plane/src/lib/auth/dataplane-fetch.ts
new file mode 100644
index 000000000..a4f3f18a7
--- /dev/null
+++ b/hindsight-control-plane/src/lib/auth/dataplane-fetch.ts
@@ -0,0 +1,51 @@
+import { cookies } from "next/headers";
+
+import { OWN_AUTH_HEADER, openApiKey } from "@/lib/auth/api-key-session";
+import { ACCESS_KEY_COOKIE } from "@/lib/auth/session";
+
+/**
+ * API-key mode: every server-side request to the dataplane carries the signed-in
+ * person's key, whichever route or SDK call made it. Installed once at startup
+ * (instrumentation.ts) by wrapping fetch, so routes need no changes.
+ *
+ * Fails closed: a request without a valid session goes out with no
+ * Authorization at all (HINDSIGHT_CP_DATAPLANE_API_KEY is never sent), and the
+ * dataplane refuses it.
+ */
+export function installDataplaneKeyFetch(dataplaneUrl: string, secret: string): void {
+  const dataplaneOrigin = new URL(dataplaneUrl).origin;
+  const original = globalThis.fetch;
+
+  globalThis.fetch = async function dataplaneKeyFetch(input: RequestInfo | URL, init?: RequestInit) {
+    const url = input instanceof Request ? input.url : String(input);
+    let origin: string;
+    try {
+      origin = new URL(url).origin;
+    } catch {
+      return original(input, init);
+    }
+    if (origin !== dataplaneOrigin) return original(input, init);
+
+    const headers = new Headers(input instanceof Request ? input.headers : undefined);
+    new Headers(init?.headers).forEach((value, name) => headers.set(name, value));
+    if (headers.get(OWN_AUTH_HEADER)) {
+      headers.delete(OWN_AUTH_HEADER);
+    } else {
+      headers.delete("authorization");
+      const apiKey = await sessionApiKey(secret);
+      if (apiKey) headers.set("authorization", `Bearer ${apiKey}`);
+    }
+
+    if (input instanceof Request) return original(new Request(input, { ...init, headers }));
+    return original(input, { ...init, headers });
+  };
+}
+
+async function sessionApiKey(secret: string): Promise<string | null> {
+  try {
+    return await openApiKey((await cookies()).get(ACCESS_KEY_COOKIE)?.value, secret);
+  } catch {
+    // Outside a request (startup checks): no session, no key.
+    return null;
+  }
+}
